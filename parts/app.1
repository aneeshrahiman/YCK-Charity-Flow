        function clearAllData() {
            if (confirm('⚠️ WARNING: This will permanently delete ALL data including loans. This cannot be undone. Are you sure?')) {
                if (confirm('Final confirmation: Delete everything?')) {
                    transactions = [];
                    members = [];
                    loans = [];
                    settings = {
                        financialYear: '2024-25',
                        openingBalance: { nre: 0, nro: 0, cash: 0 },
                        expenseCategories: ['Operations', 'Programs', 'Utilities', 'Salaries', 'Marketing', 'Events', 'Other', 'Loans Given'],
                        beneficiaries: ['General', 'Office', 'Charity Works', 'Maintenance', 'Member Loans']
                    };
                    localStorage.removeItem(STORAGE_KEY);
                    // Clear old keys too
                    ['yck_charity_data', 'yck_charity_data_v2', 'yck_charity_data_v3'].forEach(key => {
                        localStorage.removeItem(key);
                    });
                    updateDashboard();
                    renderTransactions();
                    renderMembers();
                    renderLoans();
                    renderSettings();
                    updateBackupInfo();
                    showToast('All data cleared', 'success');
                }
            }
        }

        // Export/Import
        function exportData() {
            const data = {
                transactions: transactions,
                members: members,
                loans: loans,
                settings: settings,
                exportDate: new Date().toISOString(),
                version: '4.0',
                app: 'YCK Charity Flow'
            };
            
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `yck-charity-backup-${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('Backup downloaded successfully', 'success');
        }

        function exportCSV() {
            let csv = 'ID,Date,Description,Category,Type,Amount,Account,Member,Payment Mode,Beneficiary,Loan ID\n';
            transactions.forEach(t => {
                const member = t.memberId ? members.find(m => m.id === t.memberId)?.name : '';
                const loanId = t.loanId || '';
                csv += `${t.id},${t.date},"${t.description}",${t.category},${t.type},${t.amount},${t.account || 'cash'},${member},${t.paymentMode || ''},${t.beneficiary || ''},${loanId}\n`;
            });
            
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `yck-charity-transactions-${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('CSV exported successfully', 'success');
        }

