        // Data Persistence with Migration
        function saveData() {
            const data = {
                transactions: transactions,
                members: members,
                loans: loans, // Include loans
                settings: settings,
                lastSaved: new Date().toISOString(),
                version: '4.0'
            };
            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
            updateBackupInfo();
        }

        function autoSave() {
            saveData();
        }

        function forceSave() {
            saveData();
            showToast('Data saved successfully', 'success');
        }

        function loadData() {
            // Try to load from new storage key first
            let saved = localStorage.getItem(STORAGE_KEY);
            
            // If not found, try to migrate from old versions
            if (!saved) {
                const oldKeys = ['yck_charity_data', 'yck_charity_data_v2', 'yck_charity_data_v3'];
                for (const key of oldKeys) {
                    const oldData = localStorage.getItem(key);
                    if (oldData) {
                        saved = oldData;
                        // Migrate and save to new key
                        migrateData(JSON.parse(oldData));
                        showToast('Data migrated successfully', 'success');
                        return;
                    }
                }
            }
            
            if (saved) {
                try {
                    const data = JSON.parse(saved);
                    migrateData(data);
                } catch (e) {
                    console.error('Error loading data:', e);
                    loadDemoData();
                }
            } else {
                loadDemoData();
            }
        }

        function migrateData(data) {
            // Migrate transactions
            transactions = data.transactions || [];
            
            // Migrate members
            members = data.members || [];
            
            // Migrate loans (new field) - ensure each loan has required fields
            loans = (data.loans || []).map(loan => ({
                id: loan.id || Date.now() + Math.random(),
                memberId: loan.memberId,
                amount: parseFloat(loan.amount) || 0,
                repaid: parseFloat(loan.repaid) || 0,
                date: loan.date || new Date().toISOString().split('T')[0],
                purpose: loan.purpose || '',
                account: loan.account || 'cash',
                isExisting: Boolean(loan.isExisting),
                status: loan.status || 'active', // active, closed
                closedDate: loan.closedDate || null,
                repayments: loan.repayments || [] // Track individual repayments
            }));
            
            // Migrate settings with defaults for new fields
            if (data.settings) {
                if (typeof data.settings.openingBalance === 'number') {
                    settings = {
                        financialYear: data.settings.financialYear || '2024-25',
                        openingBalance: {
                            nre: data.settings.openingBalance || 0,
                            nro: 0,
                            cash: 0
                        },
                        expenseCategories: data.settings.expenseCategories || settings.expenseCategories,
                        beneficiaries: data.settings.beneficiaries || settings.beneficiaries
                    };
                } else {
                    settings = {
                        financialYear: data.settings.financialYear || '2024-25',
                        openingBalance: data.settings.openingBalance || { nre: 0, nro: 0, cash: 0 },
                        expenseCategories: data.settings.expenseCategories || settings.expenseCategories,
                        beneficiaries: data.settings.beneficiaries || settings.beneficiaries
                    };
                }
            }
            
            // Ensure new categories exist
            if (!settings.expenseCategories.includes('Loans Given')) {
                settings.expenseCategories.push('Loans Given');
            }
            if (!settings.beneficiaries.includes('Member Loans')) {
                settings.beneficiaries.push('Member Loans');
            }
            
            // Save migrated data
            saveData();
        }

