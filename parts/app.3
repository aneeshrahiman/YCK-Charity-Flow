                    // Handle loan repayment
                    const loanId = document.getElementById('repayment-loan').value;
                    if (!loanId) {
                        showToast('Please select a loan for repayment', 'error');
                        return;
                    }
                    
                    const loan = loans.find(l => l.id == loanId);
                    if (!loan) {
                        showToast('Loan not found', 'error');
                        return;
                    }
                    
                    const remaining = loan.amount - loan.repaid;
                    if (amount > remaining) {
                        showToast(`Repayment amount exceeds remaining loan balance (${formatCurrency(remaining)})`, 'error');
                        return;
                    }
                    
                    // Update loan
                    loan.repaid += amount;
                    loan.repayments.push({
                        date: date,
                        amount: amount,
                        transactionId: transaction.id
                    });
                    
                    // Check if loan is fully repaid
