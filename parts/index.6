w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Monthly amount they commit to pay"><p class="text-xs text-gray-500 mt-1">This amount will be added to pending balance each month</p></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Current Balance (₹)</label><input type="number" id="member-balance" step="0.01" value="0" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none" placeholder="0.00"><p class="text-xs text-gray-500 mt-1">Positive for pending dues, negative for advance payment</p></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Total Contributed (₹)</label><input type="number" id="member-contributed" step="0.01" value="0" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none" placeholder="0.00"><p class="text-xs text-gray-500 mt-1">Total amount contributed till date</p></div><div class="flex flex-col sm:flex-row gap-3 pt-4"><button type="button" onclick="closeMemberModal()" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancel</button><button type="submit" class="flex-1 px-4 py-2 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg hover:shadow-lg transition">Save Member</button></div></form></div></div><div id="atm-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4"><div class="glass-panel rounded-2xl p-6 w-full max-w-md transform transition-all scale-95 opacity-0" id="atm-modal-content"><div class="flex justify-between items-center mb-4"><h3 id="transfer-modal-title" class="text-xl font-bold text-gray-800">ATM Withdrawal to Cash</h3><button onclick="closeAtmModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times text-xl"></i></button></div><form class="space-y-4" onsubmit="saveAtmWithdrawal(event)"><input id="transfer-mode" type="hidden" value="withdrawal"><div id="transfer-notice" class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm text-blue-800"><i class="fas fa-exchange-alt mr-1"></i><span id="transfer-notice-text">This is an internal transfer, not income or an expense. It reduces the chosen bank account and increases Cash in Hand by the same amount.</span></div><div id="transfer-account-container"><label class="block text-sm font-medium text-gray-700 mb-1">Withdraw from <span class="text-red-500">*</span></label><select id="atm-from-account" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none"><option value="nre">NRE Account</option><option value="nro">NRO Account</option></select></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Amount (₹) <span class="text-red-500">*</span></label><input id="atm-amount" type="number" min="0.01" step="0.01" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="0.00"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Date <span class="text-red-500">*</span></label><input id="atm-date" type="date" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Reference / note <span class="text-gray-400">(optional)</span></label><input id="atm-note" type="text" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 outline-none" placeholder="ATM location or reference"></div><div class="flex gap-3 pt-2"><button type="button" onclick="closeAtmModal()" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancel</button><button type="submit" class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Record Transfer</button></div></form></div></div><div id="loan-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4"><div class="glass-panel rounded-2xl p-6 w-full max-w-lg transform transition-all scale-95 opacity-0 max-h-[90vh] overflow-y-auto" id="loan-modal-content"><div class="flex justify-between items-center mb-4"><h3 id="loan-modal-title" class="text-xl font-bold text-gray-800">Issue New Loan</h3><button onclick="closeLoanModal()" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times text-xl"></i></button></div><form id="loan-form" class="space-y-4" onsubmit="saveLoan(event)"><input type="hidden" id="loan-entry-type" value="new"><div id="existing-loan-notice" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-3"><p class="text-sm text-blue-800"><i class="fas fa-info-circle mr-1"></i><strong>Opening loan balance:</strong> this adds the member's existing outstanding balance to the loan register only. It will not change any bank or cash balance.</p></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Select Member <span class="text-red-500">*</span></label><select id="loan-member" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none"><option value="">-- Select Member --</option></select><p class="text-xs text-orange-600 mt-1 hidden" id="no-members-loan-msg">No members available. Please add members first.</p></div><div><label id="loan-amount-label" class="block text-sm font-medium text-gray-700 mb-1">Loan Amount (₹) <span class="text-red-500">*</span></label><input type="number" id="loan-amount" step="0.01" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Enter loan amount"></div><div id="loan-account-container"><label class="block text-sm font-medium text-gray-700 mb-1">Purpose/Description</label><input type="text" id="loan-purpose" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Enter loan purpose..."></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Issue Date <span class="text-red-500">*</span></label><input type="date" id="loan-date" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none"></div><div><label class="block text-sm font-medium text-gray-700 mb-1">Account <span class="text-red-500">*</span></label><select id="loan-account" required class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-purple-500 outline-none"><option value="nre">NRE Account</option><option value="nro">NRO Account</option><option value="cash">Cash in Hand</option></select><p class="text-xs text-gray-500 mt-1">Select account from which loan amount will be deducted</p></div><div id="new-loan-notice" class="bg-yellow-50 border border-yellow-200 rounded-lg p-3"><p class="text-sm text-yellow-800"><i class="fas fa-info-circle mr-1"></i><strong>Note:</strong> This will create an expense transaction deducting the loan amount from the selected account. The loan will be tracked separately until fully repaid. </p></div><div class="flex flex-col sm:flex-row gap-3 pt-4"><button type="button" onclick="closeLoanModal()" class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition">Cancel</button><button id="loan-save-button" type="submit" class="flex-1 px-4 py-2 bg-gradient-to-r from-red-600 to-pink-600 text-white rounded-lg hover:shadow-lg transition">Issue Loan</button></div></form></div></div><script src="app.js"></script></body></html>